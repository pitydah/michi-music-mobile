<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AIR-02: the AirCat single-flight guard is a FileLock, and a FileLock can only
      be proven across process boundaries. This provider runs in its own process so
      an instrumented test can contend for the very same lock file the app uses.
    -->
    <application>
        <!--
          UI8-KILLCRITIC: the playlist image import only accepts content:// URIs, so the
          full-screen capture publishes its generated banners through this provider and
          imports them through the same path a user pick uses.
        -->
        <provider
            android:name="org.michimusic.mobile.ui.screens.ArtworkProbeProvider"
            android:authorities="${applicationId}.artworkprobe"
            android:exported="true" />
        <provider
            android:name="org.michimusic.mobile.sync.AirCatLockProbeProvider"
            android:authorities="${applicationId}.aircatlockprobe"
            android:exported="true"
            android:process=":aircatlockprobe" />
    </application>

</manifest>
